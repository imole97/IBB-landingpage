# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Must be on a domain verified in Resend (SPF + DKIM records added to DNS).
RESEND_FROM="Interiors By B. <hello@interiorsbyb.net>"

# Where waitlist signups are delivered.
NOTIFY_EMAIL=

# Canonical origin. Drives metadata, sitemap, robots and JSON-LD.
# NEXT_PUBLIC_* is inlined at BUILD time — it must be set when the build runs.
NEXT_PUBLIC_SITE_URL=https://www.interiorsbyb.net

# Optional runtime override, read on every request. Server-side code
# (transactional emails) prefers this, so a build that missed the public
# var can't bake a wrong origin into a link or the logo. Set it to the
# same value as NEXT_PUBLIC_SITE_URL.
SITE_URL=https://www.interiorsbyb.net

# Force the mock signup path for a local PRODUCTION build (npm start), so the
# form succeeds and the page-turn can be exercised without sending mail.
# In `npm run dev` this happens automatically whenever the Resend keys above
# are unset — you don't need this. Never set it on a real deployment.
MOCK_SIGNUP=0
